FROM python:3.12-slim
RUN python -m pip install --no-cache-dir uv==0.11.23 && useradd --create-home --uid 1000 sentry
USER sentry
WORKDIR /home/sentry/app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_LINK_MODE=copy UV_CACHE_DIR=/tmp/sentry-uv-cache PORT=10000
COPY --chown=sentry:sentry . .
RUN uv sync --frozen --no-dev
CMD [".venv/bin/uvicorn", "sentinelops_arena.pilot.web:app", "--host", "0.0.0.0", "--port", "10000", "--proxy-headers"]
