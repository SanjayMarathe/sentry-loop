# Add credentials to .env; that file is ignored by Git. Never put keys in the UI.
OPENAI_API_KEY=
SENTRY_OPENAI_MODEL=gpt-4.1-mini
TENKI_API_KEY=
HF_TOKEN=

# Trackio Space for the original Arena's Qwen GRPO training graphs.
SENTRY_TRACKIO_SPACE=
SENTRY_TRAINING_REPLAY_SPACE=
# Exact origin serving the replay app, without a trailing slash.
SENTRY_TRAINING_REPLAY_ORIGIN=
# Optional public links shown in the UI and published replay Space.
SENTRY_TRAINING_REPLAY_URL=
SENTRY_PUBLIC_APP_URL=
SENTRY_SOURCE_URL=
# Optional separate destination for archived CPU proposal-filter experiments.
# SENTRY_SANDBOX_TRACKIO_SPACE=
# auto selects a free static graph Space for accounts without Pro.
# static = sync completed runs; gradio = live Trackio server (requires HF Pro).
SENTRY_TRACKIO_MODE=auto
# Free static portal to the Tenki app, e.g. your-name/sentry-loop
SENTRY_HF_SPACE=

# Required for paid cloud/admin operations on a publicly hosted app.
# Original Arena episodes and comparisons do not require this token.
# Locally you may leave this blank. Enter it in Connections to unlock cloud controls.
SENTRY_CONTROL_TOKEN=
# Optional persistent directory for runs, metrics, and checkpoints.
# SENTRY_DATA_DIR=
